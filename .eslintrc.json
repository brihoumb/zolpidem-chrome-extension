{
    "env": {
        "commonjs": true,
        "es2021": true
    },
    "extends": [
        "google"
    ],
    "parserOptions": {
        "ecmaVersion": 12
    },
    "rules": {
      "indent": ["error", 2],
      "guard-for-in": 1,
      "prefer-const": 1,
      "max-len": [2, {"code": 120, "ignoreUrls": true}]
    }
}
